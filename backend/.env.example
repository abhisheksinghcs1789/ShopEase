# Rename this file to .env before running the server

PORT=5000
NODE_ENV=development

# MongoDB connection string (get a free cluster at mongodb.com/cloud/atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/shopease

# Secret used to sign JWT tokens - use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Razorpay keys (get test keys free at dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Frontend URL, used for CORS
CLIENT_URL=http://localhost:4200
